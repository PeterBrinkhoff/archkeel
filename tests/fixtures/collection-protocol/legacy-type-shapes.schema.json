{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "TypeShape": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "name"
            },
            "text": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000]+$"
            }
          },
          "required": [
            "kind",
            "text",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "member"
            },
            "text": {
              "type": "string"
            },
            "owner": {
              "$ref": "#/$defs/TypeShape"
            },
            "member": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[^\\u0000]+$"
            }
          },
          "required": [
            "kind",
            "text",
            "owner",
            "member"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "application"
            },
            "text": {
              "type": "string"
            },
            "head": {
              "$ref": "#/$defs/TypeShape"
            },
            "arguments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TypeShape"
              }
            },
            "tuple_arguments": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "text",
            "head",
            "arguments",
            "tuple_arguments"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "union"
            },
            "text": {
              "type": "string"
            },
            "left": {
              "$ref": "#/$defs/TypeShape"
            },
            "right": {
              "$ref": "#/$defs/TypeShape"
            }
          },
          "required": [
            "kind",
            "text",
            "left",
            "right"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "literal"
            },
            "text": {
              "type": "string"
            },
            "literal_kind": {
              "enum": [
                "string",
                "integer",
                "boolean",
                "none",
                "ellipsis",
                "other"
              ]
            }
          },
          "required": [
            "kind",
            "text",
            "literal_kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unpack"
            },
            "text": {
              "type": "string"
            },
            "argument": {
              "$ref": "#/$defs/TypeShape"
            }
          },
          "required": [
            "kind",
            "text",
            "argument"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unresolved"
            },
            "text": {
              "type": "string"
            },
            "valid_syntax": {
              "type": "boolean"
            }
          },
          "required": [
            "kind",
            "text",
            "valid_syntax"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$ref": "#/$defs/TypeShape"
}
