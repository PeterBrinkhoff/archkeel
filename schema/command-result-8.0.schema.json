{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archkeel:command-result:8.0.0",
  "title": "Archkeel command JSON results",
  "$comment": "AD-227. Read unchanged command-result6/7 packets. An incomplete report may additionally retain a traceable FAIL alongside UNKNOWN coverage; require a FAIL assessment or an explicit rule/component lens which may omit that assessment. Never permit incomplete PASS. SourceFacts and ArchitectureIR versions are unchanged. Shape validation does not authenticate source proof. Register all bundled schemas by $id for offline validation.",
  "anyOf": [
    {
      "$ref": "urn:archkeel:command-result:7.0.0"
    },
    {
      "type": "object",
      "required": [
        "command",
        "exit_code",
        "observation_complete",
        "declared_rules",
        "expectation_fulfilled",
        "diagnostics",
        "coverage",
        "architecture_projection",
        "rule_assessments"
      ],
      "properties": {
        "command": {
          "const": "report"
        },
        "exit_code": {
          "const": 2
        },
        "observation_complete": {
          "const": "UNKNOWN"
        },
        "declared_rules": {
          "const": "FAIL"
        },
        "expectation_fulfilled": {
          "const": "UNKNOWN"
        },
        "diagnostics": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/diagnostics"
        },
        "coverage": {
          "allOf": [
            {
              "$ref": "urn:archkeel:command-result:6.0.0#/properties/coverage"
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "const": "FAIL"
                }
              }
            }
          ]
        },
        "observation": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/observation"
        },
        "python_version": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/python_version"
        },
        "measurements": {
          "type": "null"
        },
        "artifact": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/artifact"
        },
        "git_predicate": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/git_predicate"
        },
        "host_order": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/host_order"
        },
        "host_source": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/host_source"
        },
        "failures": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/failures"
        },
        "widenings": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/widenings"
        },
        "amendment_status": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/amendment_status"
        },
        "baseline_new": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/baseline_new"
        },
        "baseline_resolved": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/baseline_resolved"
        },
        "delta": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/delta"
        },
        "provenance": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/provenance"
        },
        "open_decisions": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/open_decisions"
        },
        "open_decision_count": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/open_decision_count"
        },
        "open_decisions_complete": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/open_decisions_complete"
        },
        "agent_decisions": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/agent_decisions"
        },
        "claims": {
          "type": "null"
        },
        "violations_by_rule": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/violations_by_rule"
        },
        "violations_by_component_pair": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/violations_by_component_pair"
        },
        "draft_sizes": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/draft_sizes"
        },
        "report_filter": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/report_filter"
        },
        "filtered_violations": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/filtered_violations"
        },
        "unresolved_call_changes": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/unresolved_call_changes"
        },
        "unresolved_call_note": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/unresolved_call_note"
        },
        "filtered_calls": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/filtered_calls"
        },
        "architecture_projection": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/architecture_projection"
        },
        "rule_assessments": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/rule_assessments"
        },
        "baseline_path": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/baseline_path"
        },
        "baseline_comparisons": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/baseline_comparisons"
        },
        "interface_budgets": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/interface_budgets"
        },
        "scan_roots": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/scan_roots"
        },
        "renames": {
          "$ref": "urn:archkeel:command-result:6.0.0#/properties/renames"
        }
      },
      "additionalProperties": false,
      "anyOf": [
        {
          "properties": {
            "rule_assessments": {
              "type": "array",
              "contains": {
                "properties": {
                  "status": {
                    "const": "FAIL"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          }
        },
        {
          "properties": {
            "report_filter": {
              "type": "object",
              "anyOf": [
                {
                  "properties": {
                    "rule": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "rule"
                  ]
                },
                {
                  "properties": {
                    "component": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "component"
                  ]
                }
              ]
            }
          },
          "required": [
            "report_filter"
          ]
        }
      ]
    }
  ]
}
